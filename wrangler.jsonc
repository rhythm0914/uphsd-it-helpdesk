{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uphsd-it-helpdesk",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./cloudflare/worker-entry.ts",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://vrnkzglwzwojrxlpofss.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_P2SvmRz1D8X5ffGEoxN12Q_IuO8bUvO",
    "NEXT_PUBLIC_BASE_URL": "https://uphsd-it-helpdesk.rycanano.workers.dev",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct"
  }
}
