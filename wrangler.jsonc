{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uphsd-it-helpdesk",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./cloudflare/worker-entry.ts",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  // Hourly maintenance pass: 3-day reminders, 5-day No Response closes and SLA
  // escalation. Runs at :00 UTC (08:00 Asia/Manila). The handler is the
  // `scheduled()` export in cloudflare/worker-entry.ts; the work itself runs in
  // Postgres so a replayed run cannot double-close a ticket.
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://vrnkzglwzwojrxlpofss.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_P2SvmRz1D8X5ffGEoxN12Q_IuO8bUvO",
    "NEXT_PUBLIC_BASE_URL": "https://uphsd-it-helpdesk.rycanano.workers.dev",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast"
  },
  // RESEND_API_KEY is optional for email notifications. Set it as a Worker
  // secret (never a var): wrangler secret put RESEND_API_KEY.
  // Without it, email delivery is skipped with a warning and in-app only is used.
}
